19:<manifest xmlns:android="http://schemas.android.com/apk/res/android"
20:        package="com.android.systemui">
21:
22:    <!-- QS Tiles -->
23:    <uses-permission android:name="android.permission.MAINLINE_NETWORK_STACK" />
24:    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
25:    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
26:    <uses-permission android:name="lineageos.permission.HARDWARE_ABSTRACTION_ACCESS" />
27:
28:    <!-- SystemUI Tuner -->
29:    <application>
30:        <activity-alias
31:            android:name=".tuner.StatusBarTuner"
32:            android:targetActivity=".tuner.TunerActivity"
33:            android:icon="@drawable/tuner"
34:            android:theme="@style/Theme.SubSettingsBase.Expressive"
35:            android:label="@string/status_bar_icons_title"
36:            android:process=":tuner"
37:            android:exported="true">
38:            <intent-filter>
39:                <action android:name="com.android.settings.action.STATUS_BAR_TUNER" />
40:                <category android:name="android.intent.category.DEFAULT" />
41:            </intent-filter>
42:        </activity-alias>
43:        <provider
            android:name="com.android.systemui.island.IslandPermissionProvider"
            android:authorities="miui.statusbar.notification.public"
            android:enabled="@bool/config_uwuIslandEnabled"
            android:exported="true"
            android:multiprocess="false" />
        <activity
            android:name="com.android.systemui.island.IslandSettingsActivity"
            android:enabled="@bool/config_uwuIslandEnabled"
            android:exported="true"
            android:permission="android.permission.STATUS_BAR"
            android:theme="@style/Theme.SubSettingsBase.Expressive"
            android:label="Island"
            android:excludeFromRecents="true" />
    </application>
44:
45:</manifest>